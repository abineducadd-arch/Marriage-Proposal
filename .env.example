# ==============================================================================
# Romantic Proposal Website — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your Supabase and ElevenLabs credentials.
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit your actual .env file with secrets to Git.
# 2. Only use the public/publishable (anon) key in this frontend application.
# 3. Server secrets (such as ELEVENLABS_API_KEY) must NEVER have a VITE_ prefix.
# ==============================================================================

# Your Supabase Project URL (found in Project Settings -> API)
# Example: https://xyzcompanyproject.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Publishable / Anon API Key (found in Project Settings -> API)
# This key is safe to use in frontend client code with Row-Level Security (RLS) enabled.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Optional alias (supported if you already have VITE_SUPABASE_ANON_KEY configured):
# VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# ==============================================================================
# Mochi Character Voice — ElevenLabs Text-to-Speech (Server-side Only)
# ==============================================================================
# Do NOT prefix with VITE_. This key is accessed only in the server-side endpoint (/api/tts).
# In production on Vercel: Add this in Vercel Dashboard -> Project Settings -> Environment Variables.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Mochi's Voice ID (representing Mochi's consistent cute character voice identity)
# Cloned from /audio/mochi/bunny voice.mp3 or selected from ElevenLabs library
ELEVENLABS_VOICE_ID=JwxwlY78dl6Z7tocY1a6

# Optional deployment build preset:
# NITRO_PRESET=vercel
