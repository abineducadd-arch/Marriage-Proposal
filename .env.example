# ==============================================================================
# Romantic Proposal Website — Supabase Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your Supabase project credentials.
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit your actual .env file with secrets to Git.
# 2. Only use the public/publishable (anon) key in this frontend application.
# 3. NEVER put the service_role key or secret API key here.
# ==============================================================================

# Your Supabase Project URL (found in Project Settings -> API)
# Example: https://xyzcompanyproject.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Publishable / Anon API Key (found in Project Settings -> API)
# This key is safe to use in frontend client code with Row-Level Security (RLS) enabled.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Optional alias (supported if you already have VITE_SUPABASE_ANON_KEY configured):
# VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
